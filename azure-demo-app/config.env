########################################################################
# Deployment configuration — edit these values, then run ./deploy.sh
########################################################################

# Short name used as a prefix for every resource (lowercase letters/numbers only)
PREFIX="oaktdemo"

# Azure region for all resources
LOCATION="canadacentral"

# Optional: pin to a specific subscription (leave empty to use the current
# `az account show` default)
SUBSCRIPTION_ID=""

# Name of the file share used for uploads
FILE_SHARE_NAME="uploads"

# Name of the Cosmos DB (Table API) table that stores file metadata
COSMOS_TABLE_NAME="filemetadata"

# How often the Function App scans the file share for new/changed files
# (NCRONTAB format: second minute hour day month day-of-week)
TIMER_SCHEDULE="0 */2 * * * *"

# SKUs (kept small/cheap for a demo — change if you need more headroom)
FUNCTION_PLAN_SKU="EP1"          # Elastic Premium, Linux, required for custom containers
COSMOS_THROUGHPUT="400"          # RU/s, minimum manual throughput
ACR_SKU="Basic"
STORAGE_SKU="Standard_LRS"

# Container Apps ingress port for the FastAPI app
FASTAPI_PORT="8000"

########################################################################
# Auth (demo only — see README's Authentication section for caveats)
########################################################################

# Key Vault secret names used for JWT signing key and the hashed user list
JWT_SECRET_NAME="jwt-signing-key"
APP_USERS_SECRET_NAME="app-users"

# How long an issued JWT stays valid
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# Demo accounts seeded into Key Vault at deploy time, one per line, as
# username:password:role  (role is one of: reader, writer, admin)
#
# *** These are plaintext DEMO credentials for a training environment only.
#     Only the PBKDF2 hash of each password is ever stored in Azure (in
#     Key Vault) — the plaintext here is used solely, locally, at deploy
#     time to compute that hash. Change these before showing this to
#     anyone outside your own demo. ***
DEMO_USERS=$(cat <<'USERS'
oak-reader:ReaderPass!123:reader
oak-writer:WriterPass!123:writer
oak-admin:AdminPass!123:admin
USERS
)
